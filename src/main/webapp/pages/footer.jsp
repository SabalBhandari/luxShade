    <!-- Contact -->
    <div class="footer-contact">
      <h4>Contact Us</h4>
      <div class="contact-item">
        <span class="icon"><i class="fa-solid fa-phone"></i></span>
        <span>92472939</span>
      </div>
      <div class="contact-item">
        <span class="icon"><i class="fa-regular fa-envelope"></i></span>
        <span>asdns@gmail.com</span>
      </div>
